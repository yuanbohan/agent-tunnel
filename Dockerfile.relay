FROM golang:1.25-alpine AS builder

WORKDIR /src

RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=v0.1.0-dev
ARG DISTRIBUTION_MARKER=non-release
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_TIME=unknown
ARG TARGETOS
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w \
    -X yuanbohan/tunnel/internal/buildinfo.Version=${VERSION} \
    -X yuanbohan/tunnel/internal/buildinfo.DistributionMarker=${DISTRIBUTION_MARKER} \
    -X yuanbohan/tunnel/internal/buildinfo.GitCommit=${GIT_COMMIT} \
    -X yuanbohan/tunnel/internal/buildinfo.GitBranch=${GIT_BRANCH} \
    -X yuanbohan/tunnel/internal/buildinfo.BuildTime=${BUILD_TIME}" \
    -o /out/relay \
    ./cmd/relay

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/relay /usr/local/bin/relay

ENV RELAY_LISTEN_ADDR=0.0.0.0:8586

EXPOSE 8586
EXPOSE 3478/udp

ENTRYPOINT ["/usr/local/bin/relay"]
CMD ["serve"]
